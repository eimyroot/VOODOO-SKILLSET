# Server-side only. Never expose these variables to browser bundles.
# Durable fleet backend
VOODOO_FLEET_SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
VOODOO_FLEET_SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_SECRET

# Independent authority boundaries
VOODOO_CONTROL_API_TOKEN=REPLACE_WITH_32_PLUS_BYTE_RANDOM_TOKEN
VOODOO_FLEET_WORKER_TOKEN=REPLACE_WITH_32_PLUS_BYTE_RANDOM_TOKEN
VOODOO_FLEET_VERIFIER_TOKEN=REPLACE_WITH_32_PLUS_BYTE_RANDOM_TOKEN

# Used only by the Control Plane to verify executor-v1 receipts.
VOODOO_EXECUTOR_SHARED_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET

# Deployment provenance. Pin this to the exact canonical Git commit being deployed.
VOODOO_CANONICAL_SHA=REPLACE_WITH_40_HEX_CANONICAL_GIT_SHA
