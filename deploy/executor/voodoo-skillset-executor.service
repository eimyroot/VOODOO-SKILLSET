[Unit]
Description=VOODOO-SKILLSET CASTER-MINAL Executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voodoo-executor
Group=voodoo-executor
WorkingDirectory=/opt/voodoo-skillset
EnvironmentFile=/etc/voodoo-skillset/executor.env
ExecStart=/opt/voodoo-skillset/.venv/bin/voodoo-skillset executor-serve --workspace-root /srv/voodoo/workspaces --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/voodoo/workspaces
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
