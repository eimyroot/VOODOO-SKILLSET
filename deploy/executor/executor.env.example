# CASTER-MINAL executor node configuration.
# Generate the transport secret with a cryptographically secure password manager or:
#   openssl rand -hex 32
VOODOO_EXECUTOR_SHARED_SECRET=REPLACE_WITH_32_PLUS_BYTE_SECRET

# auto = prefer kernel namespace backend, otherwise use the safe container backend.
# namespace = require unshare-based kernel namespaces.
# container = require the Docker container backend.
VOODOO_EXECUTOR_BACKEND=auto

# Required by container/auto when namespaces are unavailable.
# MUST be immutable and digest-pinned. Mutable tags such as python:3.12 are rejected.
# Pre-pull this exact digest during node provisioning; runtime uses --pull=never.
VOODOO_EXECUTOR_CONTAINER_IMAGE=python@sha256:REPLACE_WITH_64_HEX_DIGEST
